# Forge Fitness AI Configuration (Server-Side Only — Never Expose to Client)
AI_PROVIDER_ORDER=gemini,openai,forge

# Google Gemini (Optional — deterministic Forge Engine runs automatically when omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Reliability & Rate Limits
AI_TIMEOUT_MS=8000
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MIN=30
AI_DAILY_TOKEN_BUDGET=120000
